@prefix : <https://who.int/whofic/contentmodel/> .
@prefix icd: <http://who.int/icd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icdschema: <http://id.who.int/icd/schema/> .
@prefix foundation: <http://id.who.int/icd/entity/> .
@base <https://who.int/whofic/contentmodel/> .

<https://who.int/whofic/contentmodel> rdf:type owl:Ontology ;
                                       dcterms:license "https://creativecommons.org/licenses/by-nd/3.0/igo/" ;
                                       rdfs:label "WhOFICOntologyContentModel" ;
                                       skos:definition "WHO-FIC Ontology Model for reference WHO-FIC classifications (ICD, ICF, ICHI)" .

#################################################################
#    Annotation properties
#################################################################

###  http://id.who.int/icd/schema/exclusion
icdschema:exclusion rdf:type owl:AnnotationProperty ;
                    rdfs:label "baseExclusion" ;
                    skos:definition "Exclusion term of a Foundation entity, from which exclusions of classification entities are computed" ;
                    skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                    rdfs:range icd:BaseExclusionTerm .


###  http://id.who.int/icd/schema/inclusion
icdschema:inclusion rdf:type owl:AnnotationProperty ;
                    rdfs:label "baseInclusion" ;
                    skos:definition "Inclusion term of a Foundation entity, from which inclusions of classification  entities are computed, may be synonym, narrower term, or subclass inclusions" ;
                    skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                    rdfs:range icd:Term .


###  http://id.who.int/icd/schema/longDefinition
icdschema:longDefinition rdf:type owl:AnnotationProperty ;
                         rdfs:label "longDefinition" ;
                         skos:definition "Long definition" ;
                         skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                         rdfs:range icd:LanguageTerm .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://who.int/icd#baseIndex
icd:baseIndex rdf:type owl:AnnotationProperty ;
              rdfs:label "baseIndex" ;
              skos:inScheme <https://who.int/whofic/contentmetamodel> ;
              rdfs:range icd:BaseIndexTerm .


###  http://who.int/icd#diagnosticCriteria
icd:diagnosticCriteria rdf:type owl:AnnotationProperty ;
                       rdfs:label "diagnosticCriteria" ;
                       skos:definition "Diagnostic Criteria" ;
                       skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                       rdfs:range icd:LanguageTerm .


###  http://who.int/icd#fullySpecifiedName
icd:fullySpecifiedName rdf:type owl:AnnotationProperty ;
                       rdfs:label "fullySpecifiedName" ;
                       skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                       rdfs:range icd:LanguageTerm .


###  http://who.int/icd#icfReference
icd:icfReference rdf:type owl:AnnotationProperty ;
                 rdfs:label "icfReference" ;
                 skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                 rdfs:range xsd:anyURI .


###  http://who.int/icd#label
icd:label rdf:type owl:AnnotationProperty ;
          rdfs:label "label" ;
          skos:inScheme <https://who.int/whofic/contentmetamodel> ;
          rdfs:range xsd:string .


###  http://who.int/icd#linearizationName
icd:linearizationName rdf:type owl:AnnotationProperty ;
                      rdfs:label "linearizationName" ;
                      skos:definition "name of linearization" ;
                      skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                      rdfs:range xsd:anyURI .


###  http://who.int/icd#referencedEntity
icd:referencedEntity rdf:type owl:AnnotationProperty ;
                     rdfs:label "referencedEntity" ;
                     skos:definition "a WHO-FIC entity referenced by another WHO-FIC entity" ;
                     skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                     rdfs:range xsd:anyURI .


###  http://who.int/icd#relatedImpairment
icd:relatedImpairment rdf:type owl:AnnotationProperty ;
                      rdfs:label "relatedImpairment" ;
                      skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                      rdfs:range icd:LanguageTerm .


###  http://who.int/icd#subclassBaseInclusion
icd:subclassBaseInclusion rdf:type owl:AnnotationProperty ;
                          rdfs:label "subclassBaseInclusion" ;
                          skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                          rdfs:range xsd:anyURI .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty ;
                rdfs:label "definition" ;
                skos:definition "definition of WHOFIC entity" ;
                skos:inScheme <https://who.int/whofic/contentmetamodel> ;
                rdfs:range icd:LanguageTerm .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "title" ;
               skos:definition "title of WHOFIC entity" ;
               skos:inScheme <https://who.int/whofic/contentmetamodel> ;
               rdfs:range icd:LanguageTerm .


###  https://w3id.org/linkml/permissible_values
linkml:permissible_values rdf:type owl:AnnotationProperty .


